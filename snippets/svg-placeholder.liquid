{% comment %} Gold line-art placeholder shown when a product has no photo yet {% endcomment %}
<svg viewBox="0 0 160 160" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id="ph-g-{{ placeholder_id | default: 'x' }}" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e8c66b"/><stop offset=".55" stop-color="#c9a227"/><stop offset="1" stop-color="#9a7a1a"/>
    </linearGradient>
  </defs>
  <path d="M30 30 C 30 86, 130 86, 130 30" fill="none" stroke="url(#ph-g-{{ placeholder_id | default: 'x' }})" stroke-width="4" stroke-linecap="round"/>
  <circle cx="80" cy="72" r="6" fill="url(#ph-g-{{ placeholder_id | default: 'x' }})"/>
  <path d="M80 80 l0 14" stroke="url(#ph-g-{{ placeholder_id | default: 'x' }})" stroke-width="3.5" stroke-linecap="round"/>
  <path d="M80 98 l14 16 -14 22 -14 -22z" fill="none" stroke="url(#ph-g-{{ placeholder_id | default: 'x' }})" stroke-width="3.5" stroke-linejoin="round"/>
</svg>
