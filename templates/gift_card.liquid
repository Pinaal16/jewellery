{% layout none %}
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} — Gift card</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body>
  <div class="page-width narrow" style="text-align:center;padding-top:4rem">
    <p class="eyebrow center">{{ shop.name }} ✦ Gift Card</p>
    <h1 class="page-title">{{ gift_card.initial_value | money }}</h1>
    {%- if gift_card.enabled == false or gift_card.expired -%}
      <p>This gift card has expired.</p>
    {%- else -%}
      <p>Your gift card code:</p>
      <p style="font-family:var(--serif);font-size:1.8rem;letter-spacing:.2em;color:var(--pine);margin:1rem 0">{{ gift_card.code | format_code }}</p>
      <p>Balance: {{ gift_card.balance | money }}</p>
    {%- endif -%}
    <p style="margin-top:2rem"><a class="btn btn-solid" href="{{ shop.url }}">Start shopping</a></p>
  </div>
</body>
</html>
