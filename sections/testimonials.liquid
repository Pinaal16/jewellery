<section class="testimonials">
  <h2 class="section-title reveal">{{ section.settings.heading }}</h2>
  <div class="testimonial-grid reveal">
    {%- for block in section.blocks -%}
      <figure {{ block.shopify_attributes }}>
        <blockquote>“{{ block.settings.quote }}”</blockquote>
        <figcaption>{{ block.settings.author }} <span aria-label="{{ block.settings.stars }} out of 5 stars">{%- for i in (1..block.settings.stars) -%}★{%- endfor -%}</span></figcaption>
      </figure>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Word of mouth" }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "info": "Real customer reviews only. Fabricated testimonials breach Australian Consumer Law." },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
