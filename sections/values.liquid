<section class="values">
  <div class="values-inner">
    {%- for block in section.blocks -%}
      <div class="value" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}<span aria-hidden="true">{{ block.settings.icon }}</span>{%- endif -%}
        <h3>{{ block.settings.heading }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Value strip",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "paragraph",
          "content": "Only state what you can back up. Claims about materials (gold plating, anti-tarnish, waterproof, hypoallergenic) are legally enforceable — get them in writing from your supplier before publishing them."
        },
        { "type": "text", "id": "icon", "label": "Icon (emoji or symbol)", "default": "✦" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value strip",
      "blocks": [
        { "type": "value", "settings": { "icon": "✦", "heading": "Free shipping", "text": "On every order over $79." } },
        { "type": "value", "settings": { "icon": "🔒", "heading": "Secure checkout", "text": "Payments processed by Shopify." } },
        { "type": "value", "settings": { "icon": "✉", "heading": "Here to help", "text": "Questions answered by a real person." } }
      ]
    }
  ]
}
{% endschema %}
