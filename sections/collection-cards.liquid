<section class="collections" id="{{ section.settings.anchor | default: section.id }}">
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow center reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
  {%- if section.settings.heading != blank -%}<h2 class="section-title reveal">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="collection-grid reveal">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      {%- comment -%} Skip cards with no collection chosen — a card that links nowhere is worse than no card {%- endcomment -%}
      {%- if col != blank -%}
        <a href="{{ col.url }}" class="collection-card" {{ block.shopify_attributes }}>
          <div class="cc-art">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 260 | image_tag: loading: 'lazy', alt: '' }}
            {%- elsif col.featured_image -%}
              {{ col.featured_image | image_url: width: 260 | image_tag: loading: 'lazy', alt: col.title }}
            {%- else -%}
              {% render 'svg-placeholder', placeholder_id: block.id %}
            {%- endif -%}
          </div>
          <h3>{{ block.settings.title | default: col.title }}</h3>
          <p>{{ block.settings.subtitle | default: col.products_count | append: ' pieces' }}</p>
        </a>
      {%- endif -%}
    {%- else -%}
      <p class="section-sub">Choose a collection for each card in the theme editor.</p>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection cards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Everything, In Its Place" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by collection" },
    { "type": "text", "id": "anchor", "label": "Anchor ID (for menu links)" }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        {
          "type": "paragraph",
          "content": "Pick a collection here — the card links to that collection's own page. Cards with nothing chosen are hidden."
        },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Card image", "info": "Falls back to the collection's own image." },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" }
      ]
    }
  ],
  "presets": [{ "name": "Collection cards" }]
}
{% endschema %}
