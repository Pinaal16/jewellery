<section class="collections">
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow center reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h2 class="section-title reveal">{{ section.settings.heading }}</h2>
  <div class="collection-grid reveal">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      <a href="{{ col.url | default: '#' }}" class="collection-card" {{ block.shopify_attributes }}>
        <div class="cc-art">
          {%- if col.featured_image -%}
            {{ col.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: col.title }}
          {%- else -%}
            {% render 'svg-placeholder', placeholder_id: block.id %}
          {%- endif -%}
        </div>
        <h3>{{ block.settings.title | default: col.title }}</h3>
        <p>{{ block.settings.subtitle }}</p>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection cards",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Everything, In Its Place" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by collection" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Charms & pendants" }
      ]
    }
  ],
  "presets": [{ "name": "Collection cards" }]
}
{% endschema %}
