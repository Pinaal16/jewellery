<div class="page-width narrow">
  <h1 class="page-title">{{ page.title | default: 'Contact' }}</h1>

  {%- if page.content != blank -%}
    <div class="rte">{{ page.content }}</div>
  {%- else -%}
    <p class="section-sub" style="text-align:left">{{ section.settings.intro }}</p>
  {%- endif -%}

  <div class="contact-grid">
    <div>
      {%- form 'contact', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-success">✦ Thanks — your message is with us. We reply within {{ section.settings.reply_time }}.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="form-error">{{ form.errors | default_errors }}</p>
        {%- endif -%}

        <label class="field-label" for="cName">Name</label>
        <input class="form-input" type="text" id="cName" name="contact[name]" value="{{ form.name }}" required>

        <label class="field-label" for="cEmail">Email</label>
        <input class="form-input" type="email" id="cEmail" name="contact[email]" value="{{ form.email }}" required>

        <label class="field-label" for="cOrder">Order number <span>(optional)</span></label>
        <input class="form-input" type="text" id="cOrder" name="contact[order number]">

        <label class="field-label" for="cBody">How can we help?</label>
        <textarea class="form-input" id="cBody" name="contact[body]" rows="6" required>{{ form.body }}</textarea>

        <button type="submit" class="btn btn-solid">Send message</button>
      {%- endform -%}
    </div>

    <aside class="contact-aside">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading }}</h3>
          <div class="rte">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "info": "Only used if the page itself has no content.",
      "default": "Questions about an order, a size, or a piece you've had your eye on? Send us a note and we'll come back to you."
    },
    { "type": "text", "id": "reply_time", "label": "Stated reply time", "default": "one business day", "info": "Only promise a window you can actually meet." }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Contact page" }]
}
{% endschema %}
