<header class="site-header">
  <nav class="nav-inner">
    <div class="nav-left">
      {%- for link in section.settings.menu.links limit: 3 -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>
    <button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-controls="mobileNav">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="logo" href="{{ routes.root_url }}">{{ shop.name | upcase }}<span class="logo-mark">✦</span></a>
    <div class="nav-right">
      {%- for link in section.settings.menu.links offset: 3 -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
      <button class="cart-btn" id="cartBtn" aria-label="Open cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="22" height="22" aria-hidden="true"><path d="M6 8h12l-1 12a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        <span class="cart-count" id="cartCount">{{ cart.item_count }}</span>
      </button>
    </div>
  </nav>
  <div class="mobile-nav" id="mobileNav">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
