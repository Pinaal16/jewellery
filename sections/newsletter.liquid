<section class="newsletter">
  <div class="newsletter-inner reveal">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    {% form 'customer' %}
      {%- if form.posted_successfully? -%}
        <p class="news-done">✦ Welcome to the inner circle — check your inbox.</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div style="display:flex;gap:.7rem;max-width:440px;margin:0 auto">
          <input type="email" name="contact[email]" placeholder="your@email.com" required aria-label="Email address">
          <button type="submit" class="btn btn-solid">Join</button>
        </div>
        {%- if form.errors -%}
          <p class="news-error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endif -%}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "First dibs & 10% off" },
    { "type": "text", "id": "text", "label": "Text", "default": "New drops, restocks and the occasional secret sale. No noise." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
