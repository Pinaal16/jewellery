<div class="page-width narrow">
  <h1 class="page-title">{{ blog.title }}</h1>
  {%- paginate blog.articles by 8 -%}
    {%- for article in blog.articles -%}
      <article style="padding:1.4rem 0;border-bottom:1px solid rgba(30,58,47,.1)">
        <h2 style="font-size:1.5rem;color:var(--pine)"><a href="{{ article.url }}">{{ article.title }}</a></h2>
        <p style="opacity:.6;font-size:.85rem;margin:.3rem 0">{{ article.published_at | date: '%d %B %Y' }}</p>
        <p>{{ article.excerpt_or_content | strip_html | truncate: 160 }}</p>
      </article>
    {%- else -%}
      <p>No posts yet.</p>
    {%- endfor -%}
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹ Prev</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next ›</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
